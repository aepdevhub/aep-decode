    body {
        font-family: 'AdobeClean-Regular', adobe-clean, "Adobe Clean", sans-serif;
    }

    .dialog-container {
        width: 166px;
        background-color: #ffffff;
        border-radius: 4px;
        border: 1px solid #B1B1B1;
        box-shadow: 0px 1px 4px 0px #00000026;
        z-index: 1000;
        padding: 4px;
