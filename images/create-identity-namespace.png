        margin: 4px 0px;
    }

    .menu {
        display: flex;
        flex-direction: column;
        gap: 4px;
        list-style-type: none;
        margin: 0;
        padding: 0;
    }

    .menu .menu_item {
        cursor: pointer;
        font-family: 'AdobeClean-Regular', adobe-clean, "Adobe Clean", sans-serif;
        align-content: center;
        font-size: 14px;
        font-weight: 400;
        line-height: 18.2px;
        text-align: left;
        color: #222222;
        padding: 0px 12px;
