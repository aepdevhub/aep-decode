r-duration: 300ms; --tg-layout-enter-delay: 0ms; --tg-layout-enter-timing-function: ease-in-out; --tg-layout-exit-duration: 300ms; --tg-layout-exit-delay: 0ms; --tg-layout-exit-timing-function: ease-in-out; --tg-layout-move-duration: 300ms; --tg-layout-move-delay: 0ms; --tg-layout-move-timing-function: var(--cubic-move);"><div class="fKQ0lq_TransitionItem WlXitW_TransitionGroupChild"><div class="select-none active:select-auto data-has-range-start:select-auto"><button type="button" class="flex items-center gap-1 text-start select-none text-token-text-tertiary dark:text-(--interactive-label-tertiary-default) hover:text-token-text-primary dark:hover:text-token-text-primary" aria-expanded="false">Worked for 1m 49s<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" data-rtl-flip="" class="icon-sm transition-transform"><use href="/cdn/assets/sprites-core-592165ef.svg#07889e" fill="currentColor"></use></svg></button><div class="fKQ0lq_Layout w-full" data-item-anchor="start" data-clip="true" data-dimension="height" style="--tg-will-change: auto; --tg-enter-opacity: 1; --tg-enter-transform: none; --tg-enter-filter: none; --tg-enter-duration: 300ms; --tg-enter-delay: 0ms; --tg-enter-timing-function: ease-in-out; --tg-exit-opacity: 0; --tg-exit-transform: none; --tg-exit-filter: none; --tg-exit-duration: 300ms; --tg-exit-delay: 0ms; --tg-exit-timing-function: ease-in-out; --tg-initial-opacity: 0; --tg-initial-transform: none; --tg-initial-filter: none; --tg-layout-enter-duration: 300ms; --tg-layout-enter-delay: 0ms; --tg-layout-enter-timing-function: ease-in-out; --tg-layout-exit-duration: 300ms; --tg-layout-exit-delay: 0ms; --tg-layout-exit-timing-function: ease-in-out; --tg-layout-move-duration: 300ms; --tg-layout-move-delay: 0ms; --tg-layout-move-timing-function: var(--cubic-move);"></div></div></div></div></div><div data-message-author-role="assistant" data-message-id="ac18f42f-4505-4d0e-b3eb-906e9c16657d" dir="auto" data-message-model-slug="gpt-5-6" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden"><div class="LR5Y_W_content markdown prose dark:prose-invert wrap-break-word w-full dark markdown-new-styling"><p dir="auto" data-start="0" data-end="146">Yes. Let’s make <strong data-start="16" data-end="76"><code data-start="18" data-end="33">identity.html</code> the first proper, detailed learning page</strong>, based on your AEP Identity session and the screenshots you provided.</p>
<p dir="auto" data-start="148" data-end="489">One limitation: I could not retrieve the contents of the Google Doc from the link, so I won’t pretend I have verified the trainer notes. I can, however, accurately use the <strong data-start="320" data-end="341">three screenshots</strong> and the Identity topics we discussed, and align the technical explanation with Adobe’s current documentation. <span class="contents" data-content-reference-start="452" data-content-reference-end="484"><span class="" data-state="closed"><span class="ms-1 inline-flex max-w-full items-center select-none relative top-[-0.094rem] translate-y-0.5 animate-[show_150ms_ease-in]" data-testid="webpage-citation-pill" style="width: 116px;"><a href="https://experienceleague.adobe.com/en/docs/experience-platform/identity/features/namespaces?utm_source=chatgpt.com" target="_blank" rel="noopener" alt="https://experienceleague.adobe.com/en/docs/experience-platform/identity/features/namespaces?utm_source=chatgpt.com" class="flex h-4.5 overflow-hidden rounded-xl pe-2 ps-1 text-[9px] font-medium transition-colors duration-150 ease-in-out text-token-text-secondary! bg-[#F4F4F4]! dark:bg-[#303030]! select-none" style="max-width: 116px;"><span class="relative start-0 bottom-0 flex h-full w-full items-center"><span class="flex h-4 w-full items-center justify-between" style="opacity: 1; transform: none;"><span class="flex min-w-0 flex-1 items-center gap-1"><span class="inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full"><img alt="" width="128" height="128" class="h-3 w-3 rounded-full" src="./create-identity-namespace_files/favicons"></span><span class="max-w-[15ch] grow truncate overflow-hidden text-center">Experience League</span></span><span class="-me-1 flex h-full items-center rounded-full px-1 text-[#8F8F8F]">+1</span></span></span></a></span></span></span></p>
<h3 data-section-id="1p1qvjd" dir="auto" data-start="491" data-end="528">What I suggest we put on the page</h3>
<p dir="auto" data-start="530" data-end="546"><strong data-start="530" data-end="546">AEP Identity</strong></p>
<ol data-start="548" data-end="1399">
<li data-section-id="1173zik" data-start="548" data-end="571">
<p dir="auto" data-start="551" data-end="571">What is an Identity?</p>
</li>
<li data-section-id="ep4aek" data-start="572" data-end="605">
<p dir="auto" data-start="575" data-end="605">What is an Identity Namespace?</p>
</li>
<li data-section-id="17d4lwm" data-start="606" data-end="646">
<p dir="auto" data-start="609" data-end="646">Identity = Namespace + Identity Value</p>
</li>
<li data-section-id="nix6fz" data-start="647" data-end="684">
<p dir="auto" data-start="650" data-end="684">Why Identity Namespace is required</p>
</li>
<li data-section-id="1d4v40z" data-start="685" data-end="717">
<p dir="auto" data-start="688" data-end="717">Standard vs Custom Namespaces</p>
</li>
<li data-section-id="19rrxkr" data-start="718" data-end="757">
<p dir="auto" data-start="721" data-end="757">Creating a Custom Identity Namespace</p>
</li>
<li data-section-id="qm9ewy" data-start="758" data-end="876">
<p dir="auto" data-start="761" data-end="801">Explain each field from your screenshot:</p>
<ul data-start="805" data-end="876">
<li data-section-id="1uae1qt" data-start="805" data-end="819">
<p dir="auto" data-start="807" data-end="819">Display Name</p>
</li>
<li data-section-id="1spw3zs" data-start="823" data-end="840">
<p dir="auto" data-start="825" data-end="840">Identity Symbol</p>
</li>
<li data-section-id="19tzd9q" data-start="844" data-end="857">
<p dir="auto" data-start="846" data-end="857">Description</p>
</li>
<li data-section-id="8xds1y" data-start="861" data-end="876">
<p dir="auto" data-start="863" data-end="876">Identity Type</p>
</li>
</ul>
</li>
<li data-section-id="k63qan" data-start="877" data-end="1047">
<p dir="auto" data-start="880" data-end="920">Identity types shown in your screenshot:</p>
<ul data-start="924" data-end="1047">
<li data-section-id="1fdt129" data-start="924" data-end="935">
<p dir="auto" data-start="926" data-end="935">Cookie ID</p>
</li>
<li data-section-id="1koi9xj" data-start="939" data-end="967">
<p dir="auto" data-start="941" data-end="967">Individual cross-device ID</p>
</li>
<li data-section-id="1tqowf7" data-start="971" data-end="991">
<p dir="auto" data-start="973" data-end="991">Hardware device ID</p>
</li>
<li data-section-id="nyyzpm" data-start="995" data-end="1018">
<p dir="auto" data-start="997" data-end="1018">Non-people identifier</p>
</li>
<li data-section-id="1717an8" data-start="1022" data-end="1029">
<p dir="auto" data-start="1024" data-end="1029">Email</p>
</li>
<li data-section-id="1h37kgn" data-start="1033" data-end="1047">
<p dir="auto" data-start="1035" data-end="1047">Phone number</p>
</li>
</ul>
</li>
<li data-section-id="1uxoc2d" data-start="1048" data-end="1205">
<p dir="auto" data-start="1051" data-end="1077"><strong data-start="1051" data-end="1077">Your trainer's example</strong></p>
<ul data-start="1081" data-end="1205">
<li data-section-id="1eobqxj" data-start="1081" data-end="1100">
<p dir="auto" data-start="1083" data-end="1100">Reliance customer</p>
</li>
<li data-section-id="13kxcgh" data-start="1104" data-end="1136">
<p dir="auto" data-start="1106" data-end="1136">Display name: <code data-start="1120" data-end="1136">Re Customer ID</code></p>
</li>
<li data-section-id="1rzzz24" data-start="1140" data-end="1173">
<p dir="auto" data-start="1142" data-end="1173">Identity symbol: <code data-start="1159" data-end="1173">recustomerid</code></p>
</li>
<li data-section-id="1koi9xj" data-start="1177" data-end="1205">
<p dir="auto" data-start="1179" data-end="1205">Individual cross-device ID</p>
</li>
</ul>
</li>
<li data-section-id="1rycupc" data-start="1206" data-end="1224">
<p dir="auto" data-start="1210" data-end="1224">Identity Graph</p>
</li>
<li data-section-id="crhoth" data-start="1225" data-end="1289">
<p dir="auto" data-start="1229" data-end="1289">Simple customer example:<br>
<code data-start="1257" data-end="1289">CRM ID → Email → ECID → Device</code></p>
</li>
<li data-section-id="1nysb8w" data-start="1290" data-end="1327">
<p dir="auto" data-start="1294" data-end="1327">How Identity connects with Schema</p>
</li>
<li data-section-id="14r1yec" data-start="1328" data-end="1357">
<p dir="auto" data-start="1332" data-end="1357">Developer/API perspective</p>
</li>
<li data-section-id="fycllm" data-start="1358" data-end="1381">
<p dir="auto" data-start="1362" data-end="1381">Interview questions</p>
</li>
<li data-section-id="ixt2im" data-start="1382" data-end="1399">
<p dir="auto" data-start="1386" data-end="1399">Key takeaways</p>
</li>
</ol>
<p dir="auto" data-start="1401" data-end="1596">Adobe describes an identity as an identity namespace plus an identity value, while the identity graph connects related identities across systems and devices. <span class="contents" data-content-reference-start="1554" data-content-reference-end="1586"><span class="" data-state="closed"><span class="ms-1 inline-flex max-w-full items-center select-none relative top-[-0.094rem] translate-y-0.5 animate-[show_150ms_ease-in]" data-testid="webpage-citation-pill" style="width: 116px;"><a href="https://experienceleague.adobe.com/en/docs/experience-platform/identity/home?utm_source=chatgpt.com" target="_blank" rel="noopener" alt="https://experienceleague.adobe.com/en/docs/experience-platform/identity/home?utm_source=chatgpt.com" class="flex h-4.5 overflow-hidden rounded-xl pe-2 ps-1 text-[9px] font-medium transition-colors duration-150 ease-in-out text-token-text-secondary! bg-[#F4F4F4]! dark:bg-[#303030]! select-none" style="max-width: 116px;"><span class="relative start-0 bottom-0 flex h-full w-full items-center"><span class="flex h-4 w-full items-center justify-between" style="opacity: 1; transform: none;"><span class="flex min-w-0 flex-1 items-center gap-1"><span class="inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full"><img alt="" width="128" height="128" class="h-3 w-3 rounded-full" src="./create-identity-namespace_files/favicons"></span><span class="max-w-[15ch] grow truncate overflow-hidden text-center">Experience League</span></span><span class="-me-1 flex h-full items-center rounded-full px-1 text-[#8F8F8F]">+1</span></span></span></a></span></span></span></p>
<p dir="auto" data-start="1598" data-end="1972">For your custom namespace screenshot, the important point is that the <strong data-start="1668" data-end="1702">display name is human-readable</strong>, while the <strong data-start="1714" data-end="1784">identity symbol/code is the unique identifier used by the platform</strong>. Adobe also notes that a custom namespace's identity symbol must be unique within the organization, and a namespace cannot be deleted after creation. <span class="contents" data-content-reference-start="1925" data-content-reference-end="1944"><span class="" data-state="closed"><span class="ms-1 inline-flex max-w-full items-center select-none relative top-[-0.094rem] translate-y-0.5 animate-[show_150ms_ease-in]" data-testid="webpage-citation-pill" style="width: 101px;"><a href="https://experienceleague.adobe.com/en/docs/experience-platform/identity/features/namespaces?utm_source=chatgpt.com" target="_blank" rel="noopener" alt="https://experienceleague.adobe.com/en/docs/experience-platform/identity/features/namespaces?utm_source=chatgpt.com" class="flex h-4.5 overflow-hidden rounded-xl pe-2 ps-1 text-[9px] font-medium transition-colors duration-150 ease-in-out text-token-text-secondary! bg-[#F4F4F4]! dark:bg-[#303030]! select-none" style="max-width: 101px;"><span class="relative start-0 bottom-0 flex h-full w-full items-center"><span class="flex h-4 w-full items-center justify-between overflow-hidden" style="opacity: 1; transform: none;"><span class="flex min-w-0 flex-1 items-center gap-1"><span class="inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full"><img alt="" width="128" height="128" class="h-3 w-3 rounded-full" src="./create-identity-namespace_files/favicons"></span><span class="max-w-[15ch] grow truncate overflow-hidden text-center">Experience League</span></span></span></span></a></span></span></span></p>
<h3 data-section-id="u8lez7" dir="auto" data-start="1974" data-end="2001">Your screenshot example</h3>
<p dir="auto" data-start="2003" data-end="2040">We can show it on the page like this:</p>
<blockquote data-start="2042" data-end="2310">
<p dir="auto" data-start="2044" data-end="2104"><strong data-start="2044" data-end="2104">Example: Creating a Reliance Customer Identity Namespace</strong></p>
<p dir="auto" data-start="2109" data-end="2310"><strong data-start="2109" data-end="2126">Display Name:</strong> <code data-start="2127" data-end="2143">Re Customer ID</code><br data-start="2143" data-end="2146">
<strong data-start="2148" data-end="2168">Identity Symbol:</strong> <code data-start="2169" data-end="2183">recustomerid</code><br data-start="2183" data-end="2186">
<strong data-start="2188" data-end="2204">Description:</strong> <code data-start="2205" data-end="2258">This identity is created for Reliance Org customer.</code><br data-start="2258" data-end="2261">
<strong data-start="2263" data-end="2281">Identity Type:</strong> <code data-start="2282" data-end="2310">Individual cross-device ID</code></p>
</blockquote>
<p dir="auto" data-start="2312" data-end="2360">Then place your screenshot immediately below it.</p>
<p dir="auto" data-start="2362" data-end="2508">This will make the page much more useful than simply copying Adobe documentation—it becomes a <strong data-start="2456" data-end="2507">trainer-session + practical AEP developer guide</strong>.</p>
<h3 data-section-id="47io0j" dir="auto" data-start="2510" data-end="2557">Important connection to your Schema session</h3>
<p dir="auto" data-start="2559" data-end="2601">We should also explicitly connect the two:</p>
<p dir="auto" data-start="2603" data-end="2732"><strong data-start="2603" data-end="2732">Schema field → marked as Identity → Namespace assigned → Identity data ingested → Identity Service → Identity Graph → Profile</strong></p>
<p dir="auto" data-start="2734" data-end="2746">For example:</p>
<pre class="overflow-visible! px-0!" data-start="2748" data-end="2912"><div class="relative w-full mt-4 mb-1"><div class=""><div class="contents"><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback"><div class="pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1"><button type="button" class="flex gap-1 items-center select-none pointer-events-auto py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-592165ef.svg#7fccfb" fill="currentColor"></use></svg></button></div><div class="relative"><div class="pe-11 pt-3" style="transform: none;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼs ͼ16"><div class="cm-scroller"><pre class="cm-content q9tKkq_readonly m-0"><code><span>CRM ID
   ↓
Schema field: customerId
   ↓
Identity = Yes
   ↓
Namespace = Re Customer ID
   ↓
Identity Service
   ↓
Identity Graph
   ↓
Customer Profile</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></div></pre>
<p dir="auto" data-start="2914" data-end="3125">Adobe confirms that identity fields in XDM require an identity namespace and that ingested identity data can create relationships between identities in different namespaces. <span class="contents" data-content-reference-start="3060" data-content-reference-end="3092"><span class="" data-state="closed"><span class="ms-1 inline-flex max-w-full items-center select-none relative top-[-0.094rem] translate-y-0.5 animate-[show_150ms_ease-in]" data-testid="webpage-citation-pill" style="width: 116px;"><a href="https://experienceleague.adobe.com/en/docs/experience-platform/identity/implementation?utm_source=chatgpt.com" target="_blank" rel="noopener" alt="https://experienceleague.adobe.com/en/docs/experience-platform/identity/implementation?utm_source=chatgpt.com" class="flex h-4.5 overflow-hidden rounded-xl pe-2 ps-1 text-[9px] font-medium transition-colors duration-150 ease-in-out text-token-text-secondary! bg-[#F4F4F4]! dark:bg-[#303030]! select-none" style="max-width: 116px;"><span class="relative start-0 bottom-0 flex h-full w-full items-center"><span class="flex h-4 w-full items-center justify-between" style="opacity: 1; transform: none;"><span class="flex min-w-0 flex-1 items-center gap-1"><span class="inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full"><img alt="" width="128" height="128" class="h-3 w-3 rounded-full" src="./create-identity-namespace_files/favicons"></span><span class="max-w-[15ch] grow truncate overflow-hidden text-center">Experience League</span></span><span class="-me-1 flex h-full items-center rounded-full px-1 text-[#8F8F8F]">+1</span></span></span></a></span></span></span></p>
<p dir="auto" data-start="3127" data-end="3318"><strong data-start="3127" data-end="3185">This is the direction I recommend for <code data-start="3167" data-end="3182">identity.html</code>.</strong> It will fit very well with the Schema page you already created and will make your website genuinely useful for someone learning AEP.</p>
<p dir="auto" data-start="3320" data-end="3493" data-is-last-node="" data-is-only-node="">If you paste the <strong data-start="3337" data-end="3379">trainer notes from the Google Doc here</strong>, I can make the page match your actual session notes exactly rather than filling in anything that wasn't covered.</p></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div aria-label="Response actions" class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none -mt-1 touch:w-[calc(100%+--spacing(3.5))] w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto cant-hover:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" role="group" tabindex="-1" acrobat-processed-response="Y" style="mask-position: 0% 0%;"><button type="button" class="text-token-text-secondary hover:bg-token-surface-hover rounded-lg" aria-label="Copy response" data-testid="copy-turn-action-button" data-state="closed" acrobat-processed-response="Y"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><div class="[&amp;_svg]:h-full [&amp;_svg]:w-full icon icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" focusable="false" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M15.1006 1.78516C16.793 1.78556 18.165 3.15808 18.165 4.85059V10.8838C18.1649 12.5762 16.7929 13.9478 15.1006 13.9482H13.998V15.0508C13.9976 16.7431 12.626 18.1151 10.9336 18.1152H4.90039C3.20789 18.1152 1.83537 16.7432 1.83496 15.050