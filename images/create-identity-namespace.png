    .fab-fte-background {
        position: absolute;
        left: -13px;
        top: 50%;
        transform: translateY(-50%);
        width: 183.33px;
        height: 126.82px;
        background: url('chrome-extension://efaidnbmnnnibpcajpcglclefindmkaj/browser/images/fab-header-background.svg') no-repeat center;
        background-size: cover;
        pointer-events: none;
        z-index: 0;
    }

    .fab-fte-close {
        position: absolute;
        top: 0;
        right: 0;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        cursor: pointer;
        z-index: 2;
        color: #222222;
        padding: 0;
    }

    .fab-fte-close:hover {
        background: rgba(0, 0, 0, 0.05);
        border-radius: 12px;
    }

    .fab-fte-close svg {
        width: 8px;
        height: 8px;
    }

    .fab-fte-text {
        position: relative;
        width: 102px;
        font-family: 'AdobeClean-Bold', adobe-clean, sans-serif;
        font-weight: 400; /* Use Bold font file directly, not synthetic bold */
        font-size: 12px;
